# Passwort-Hash erzeugen: node scripts/hash.mjs '<passwort>'  (Hash in einfache Anführungszeichen setzen: enthält $)
DASHBOARD_PASSWORD_HASH=
# Zufallswert, min. 32 Zeichen: openssl rand -base64 48
SESSION_SECRET=
# true, sobald die Seite per HTTPS (Reverse Proxy) läuft
COOKIE_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
# Synology: uid/gid des NAS-Benutzers (Ausgabe von: id)
PUID=1000
PGID=1000
# Standard nur lokal; im Heimnetz ohne Reverse Proxy: LAN-IP der NAS eintragen
BIND_HOST=127.0.0.1
