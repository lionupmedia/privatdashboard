# Passwort-Hash erzeugen: node scripts/hash.mjs '<passwort>'  (Hash in einfache Anführungszeichen setzen: enthält $)
DASHBOARD_PASSWORD_HASH=
# Zufallswert, min. 32 Zeichen: openssl rand -base64 48
SESSION_SECRET=
# true, sobald die Seite per HTTPS (Reverse Proxy) läuft
COOKIE_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
